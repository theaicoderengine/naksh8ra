# Atlas Hiring — environment configuration template.
# Copy to .env (local) or load into your secret manager (staging/production).
# Values here are PLACEHOLDERS. Never commit real credentials.
# The server validates this configuration at start-up (src/server/env.ts).

# ─── Application ──────────────────────────────────────────────────────────
APP_ENV="development"                     # development | test | staging | production
APP_URL="http://localhost:3000"           # public origin; used for links, CSRF origin checks, Stripe redirects
APP_NAME="Atlas Hiring"
APP_SUPPORT_EMAIL="support@example.com"
TRUST_PROXY="false"                       # "true" only behind a proxy/load balancer that sets X-Forwarded-For

# Public branding (baked into the client bundle at build time)
NEXT_PUBLIC_APP_NAME="Atlas Hiring"
NEXT_PUBLIC_APP_TAGLINE=""
NEXT_PUBLIC_BRAND_PRIMARY=""              # optional HSL triplet, e.g. "222 70% 45%"
NEXT_PUBLIC_LEGAL_ENTITY=""               # your legal entity name for footers/legal pages

# ─── Database (two roles; see scripts/db/bootstrap-roles.sql) ─────────────
# Runtime role: NOT the table owner, NOBYPASSRLS → row-level security enforced.
DATABASE_URL="postgresql://atlas_app:CHANGE_ME@localhost:5432/atlas?schema=public"
# Owner role: used only by `prisma migrate deploy` and the seed.
MIGRATION_DATABASE_URL="postgresql://atlas_owner:CHANGE_ME@localhost:5432/atlas?schema=public"
PRISMA_LOG=""                              # "1" logs every SQL query (local debugging only)

# ─── Queue / cache ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
QUEUE_MODE="redis"                         # redis (staging/prod, requires `npm run worker`) | inline (dev/tests)
WORKER_CONCURRENCY="8"
WORKER_HEALTH_PORT="3001"

# ─── Security ─────────────────────────────────────────────────────────────
# 32 random bytes, base64:  openssl rand -base64 32   (REQUIRED in staging/production)
ENCRYPTION_KEY=""
SESSION_TTL_HOURS="168"
PRIVILEGED_SESSION_TTL_HOURS="12"
PLATFORM_ADMIN_EMAILS=""                   # comma-separated; these emails get SUPER_ADMIN when they REGISTER (must then enrol MFA). Set before first sign-up, then clear.
RATE_LIMIT_MULTIPLIER="1"                  # ignored in production; raise only for local load/E2E testing

# ─── AI providers (no vendor is hard-coded; pick per environment) ─────────
# These are PLATFORM-OWNED (deployment) credentials. They stay server-side and no
# organisation can use them until a platform super-admin grants that organisation
# access per provider + capability (Admin → AI access). Organisations may instead
# connect their own Gemini / OpenAI / Anthropic keys in Settings → AI providers.
LLM_PROVIDER="none"                        # default platform provider when several are granted: anthropic | openai | gemini | fixture (tests only) | none
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_FAST_MODEL="claude-haiku-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
GEMINI_API_KEY=""                          # Google AI Studio (Gemini API) key
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FAST_MODEL="gemini-2.5-flash-lite"
# Supported-model list adjustments (add / re-label free-tier status / remove), e.g.
# [{"provider":"GEMINI","id":"gemini-3-flash","freeTier":"UNKNOWN"},{"provider":"OPENAI","id":"gpt-4.1-mini","remove":true}]
AI_MODEL_CATALOG_JSON=""
STT_PROVIDER="none"                        # openai | deepgram | fixture (tests only) | none
OPENAI_STT_MODEL="whisper-1"
DEEPGRAM_API_KEY=""
TTS_PROVIDER="browser"                     # browser (speechSynthesis) | openai | elevenlabs | none
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="alloy"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
AI_TIMEOUT_MS="60000"
# Fixture providers return deterministic canned output and label sessions FIXTURE.
# Refused when APP_ENV=production.
ALLOW_FIXTURE_PROVIDERS="false"
# Optional overrides for internal usage-cost estimates (JSON, "provider:model:unit": micro-USD per unit), e.g.
# {"anthropic:claude-opus-5-5:input_tokens": 4, "openai:whisper-1:seconds": 100}
# Check src/server/providers/usage.ts for units and replace defaults with your contracted prices.
PROVIDER_PRICES_JSON=""

# ─── File storage ─────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"                   # local (single node/dev) | s3 (any S3-compatible, private bucket)
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""                             # leave empty for AWS; set for MinIO/R2/etc.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
MAX_UPLOAD_MB="10"
MALWARE_SCANNER="none"                     # clamav | none (files are marked NOT_SCANNED)
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ─── Email ────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="console"                   # console (dev mailbox at /dev/mailbox) | smtp | resend | postmark
EMAIL_FROM="Atlas Hiring <no-reply@example.com>"
SMTP_URL=""                                # e.g. smtp://user:pass@smtp.example.com:587
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
EMAIL_WEBHOOK_SECRET=""                    # shared secret for /api/v1/webhooks/email (bounces/complaints)

# ─── Payments ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="none"                    # stripe | none
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_AUTOMATIC_TAX="false"

# ─── Observability ────────────────────────────────────────────────────────
LOG_LEVEL="info"                           # fatal | error | warn | info | debug | trace | silent
SENTRY_DSN=""                               # reserved; no error-tracking SDK is wired in yet

# ─── Development / testing only (never enable in production) ──────────────
SEED_DEMO="false"                          # `npm run db:seed` also creates fictional demo data
SEED_DEMO_PASSWORD=""                      # demo account password (default printed by the seed)
EXPOSE_TEST_TOKENS="false"                 # return invitation/verification tokens in API responses (ignored in production)
