// Atlas Hiring — database schema
//
// Conventions
// - Every tenant-owned table carries `organisationId` and is protected by
//   PostgreSQL row-level security (see migrations/*_rls). The application role
//   (`atlas_app`) is NOT the table owner, so RLS is enforced for every query.
// - Personal (student/candidate) data is owned by a User, never by a university.
// - Ledgers (credit ledger, audit events, stage history, session events) are
//   append-only; UPDATE/DELETE are blocked by triggers.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

