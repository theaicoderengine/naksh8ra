{
  "name": "atlas-hiring",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant AI recruitment SaaS (working name: Atlas Hiring)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "SERVICE_NAME=atlas-worker tsx src/worker/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "openapi": "tsx scripts/generate-openapi.ts",
    "perf": "tsx scripts/perf/api-load.ts",
    "secrets:reencrypt": "tsx scripts/secrets-reencrypt.ts",
    "db:verify-ai-access": "tsx scripts/db/verify-ai-access.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@google/genai": "2.28.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.540.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "openai": "6.49.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "postcss-selector-parser": "7.1.6"
  }
}
