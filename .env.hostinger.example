# ─────────────────────────────────────────────────────────────────────────────
# ATLAS HIRING — Hostinger Node.js Web App environment variables
# hPanel → Websites → <site> → Settings & redeploy → Environment variables
# (or "Import .env" with a filled-in copy of this file — never commit the filled copy).
#
#   [SECRET]   you must supply; keep in a password manager; never in git
#   [GENERATE] create with `npm run secrets:generate` (new deployments only)
#   [SET]      non-secret value you must set for your domain/services
#   [DEFAULT]  safe default for Hostinger; change only for a reason given here
#
# Full procedure: docs/deployment-hostinger.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment mode ──────────────────────────────────────────────────────────
DEPLOY_TARGET=hostinger                  # [DEFAULT] makes `npm run build` run preflight + migrations
APP_ENV=production                       # [SET] production | staging (staging site: staging)
APP_URL=https://hire.example.com         # [SET] exact public origin, https, no trailing slash
APP_NAME="Atlas Hiring"                  # [SET]
APP_SUPPORT_EMAIL=support@example.com    # [SET]
# Do NOT set NODE_ENV: dependencies must install with dev tooling for the build;
# the build and start commands set NODE_ENV=production themselves.

# ── Database (external managed PostgreSQL 16+; Hostinger has none) ───────────
# Runtime role atlas_app through the provider's POOLED endpoint (transaction pooling):
DATABASE_URL=postgresql://atlas_app:PASSWORD@POOLER-HOST:PORT/atlas?schema=public&sslmode=require&pgbouncer=true&connection_limit=5   # [SECRET]
# Owner role atlas_owner through the DIRECT (non-pooled) endpoint — migrations only:
MIGRATION_DATABASE_URL=postgresql://atlas_owner:PASSWORD@DIRECT-HOST:5432/atlas?schema=public&sslmode=require                          # [SECRET]

# ── Encryption (MFA secrets, organisation AI keys) ───────────────────────────
ENCRYPTION_KEY=                          # [GENERATE][SECRET] 32 bytes base64. BACK IT UP OFFLINE. Never change without docs/operations.md rotation
# ENCRYPTION_KEY_PREVIOUS=               # only during a documented key rotation

# ── Background jobs (no Redis/worker processes on Hostinger) ─────────────────
QUEUE_MODE=postgres                      # [DEFAULT] durable jobs in PostgreSQL, processed in the web process
CRON_SECRET=                             # [GENERATE][SECRET] ≥32 chars; also used in the hPanel cron job command
JOB_RUNNER_IN_PROCESS=true               # [DEFAULT]
JOB_CONCURRENCY=2                        # [DEFAULT] parallel jobs inside the web process (1–8)
# REDIS_URL=                             # optional external Redis (e.g. Upstash, rediss://…) — used for rate limits only

# ── Request limits (Hostinger stops requests after 120 s) ────────────────────
REQUEST_DEADLINE_MS=100000               # [DEFAULT] total budget per API request incl. AI calls
AI_TIMEOUT_MS=45000                      # [DEFAULT] per provider attempt
AI_MAX_RETRIES=1                         # [DEFAULT] transient-error retries (bounded by the deadline)

# ── Proxy ────────────────────────────────────────────────────────────────────
TRUST_PROXY=true                         # [DEFAULT] Hostinger's proxy sets X-Forwarded-For
TRUST_PROXY_HOPS=1                       # [DEFAULT] 2 if Hostinger CDN is enabled in front of the site

# ── File storage (S3-compatible object storage; e.g. Cloudflare R2) ──────────
STORAGE_PROVIDER=s3                      # [DEFAULT] required: the deploy folder is replaced on redeploy
S3_BUCKET=atlas-files                    # [SET] private bucket (no public access)
S3_REGION=auto                           # [SET] R2: auto; B2/Wasabi/AWS: the bucket's region
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # [SET] provider S3 endpoint (omit for AWS S3)
S3_FORCE_PATH_STYLE=true                 # [DEFAULT] for R2/B2/MinIO
S3_SSE=none                              # [DEFAULT] R2 encrypts at rest and rejects the SSE header; AES256 for AWS S3/B2
S3_ACCESS_KEY_ID=                        # [SECRET] key limited to this bucket (object read/write/delete)
S3_SECRET_ACCESS_KEY=                    # [SECRET]
MAX_UPLOAD_MB=10                         # [DEFAULT]

# ── Malware scanning ─────────────────────────────────────────────────────────
# ClamAV (clamd) cannot run on Hostinger web hosting. Uploads are type-checked by content and
# stored/shown as "not scanned". To scan, point MALWARE_SCANNER=clamav + CLAMAV_HOST/PORT at a
# clamd you operate elsewhere (private network/TLS tunnel only).
MALWARE_SCANNER=none                     # [DEFAULT]
ALLOW_UNSCANNED_UPLOADS=true             # [SET] explicit acknowledgement; required with MALWARE_SCANNER=none

# ── Email (required in production) ───────────────────────────────────────────
EMAIL_PROVIDER=postmark                  # [SET] postmark | resend | smtp
EMAIL_FROM="Atlas Hiring <no-reply@example.com>"   # [SET] domain with SPF/DKIM/DMARC
POSTMARK_SERVER_TOKEN=                   # [SECRET] if postmark
# RESEND_API_KEY=                        # [SECRET] if resend
# SMTP_URL=smtps://user:pass@smtp.hostinger.com:465  # [SECRET] if smtp (Hostinger mailboxes work; low volume)
EMAIL_WEBHOOK_SECRET=                    # [GENERATE][SECRET] bounce/complaint webhook

# ── Payments (Stripe TEST mode until live payments are authorised) ───────────
PAYMENT_PROVIDER=none                    # [SET] stripe once the keys below are set
# STRIPE_SECRET_KEY=sk_test_…            # [SECRET] test key; a live key also needs STRIPE_LIVE_APPROVED=true
# STRIPE_WEBHOOK_SECRET=whsec_…          # [SECRET] endpoint: https://<APP_URL host>/api/v1/webhooks/stripe
# STRIPE_LIVE_APPROVED=false

# ── Platform AI (optional; deny-by-default per organisation via super-admin grants) ──
# Organisations can always connect their own Gemini/OpenAI/Anthropic keys (BYOK) without these.
LLM_PROVIDER=none                        # [SET] none | anthropic | openai | gemini
# ANTHROPIC_API_KEY=                     # [SECRET]
# OPENAI_API_KEY=                        # [SECRET] also used by STT/TTS when those are "openai"
# GEMINI_API_KEY=                        # [SECRET]
STT_PROVIDER=none                        # [SET] none | openai | deepgram (typed answers when none)
# DEEPGRAM_API_KEY=                      # [SECRET]
TTS_PROVIDER=browser                     # [DEFAULT] browser | openai | elevenlabs
# ELEVENLABS_API_KEY=                    # [SECRET]

# ── Safety switches (must stay off in production) ────────────────────────────
ALLOW_FIXTURE_PROVIDERS=false
EXPOSE_TEST_TOKENS=false
SEED_DEMO=false

# ── Bootstrap / observability ────────────────────────────────────────────────
PLATFORM_ADMIN_EMAILS=                   # [SET] only while registering the first super admin; then clear + redeploy
LOG_LEVEL=info                           # [DEFAULT] JSON logs → hPanel runtime logs
